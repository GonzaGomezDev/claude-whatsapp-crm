# ─────────────────────────────────────────────────────────────────────────────
# Backend del agente: "messages_api" (producción) | "cli" (dev local)
#
#   messages_api → llama a la Messages API de Claude. Requiere ANTHROPIC_API_KEY.
#                  Es el único modo con defer_loading, tool_search, count_tokens
#                  y prompt caching. Usá este en producción y para grabar.
#
#   cli          → lanza `claude -p` como subproceso usando tu suscripción de
#                  Claude Code. No requiere API key. Ideal para iterar sobre los
#                  SKILL.md sin gastar. Limitaciones en README.md.
# ─────────────────────────────────────────────────────────────────────────────
AGENT_BACKEND=cli

# ── Claude (Messages API) ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max — medium equilibra latencia y calidad
ANTHROPIC_EFFORT=medium
ANTHROPIC_MAX_TOKENS=8000
# Máximo de vueltas del loop agéntico antes de cortar
AGENT_MAX_ITERATIONS=8

# ── Claude Code (backend cli) ────────────────────────────────────────────────
CLAUDE_CLI_PATH=claude
CLAUDE_CLI_TIMEOUT_S=120
# Tope de gasto por mensaje, para que un loop raro no te vacíe la cuenta
CLAUDE_CLI_MAX_BUDGET_USD=0.50
# Subprocesos concurrentes (cada uno cuesta 1-3s de cold start)
CLAUDE_CLI_MAX_CONCURRENCY=4

# ── Twilio ───────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# URL pública EXACTA del webhook — la firma de Twilio se valida contra esto.
# Con ngrok: https://xxxx-yy-zz.ngrok-free.app
PUBLIC_BASE_URL=
# Poné false sólo si sabés lo que hacés. Nunca en producción.
TWILIO_VALIDATE_SIGNATURE=true

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=
# service_role, no anon: el agente escribe en tablas protegidas por RLS
SUPABASE_SERVICE_ROLE_KEY=

# ── Pagos (Stripe) ───────────────────────────────────────────────────────────
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_CURRENCY=usd

# ── Human handoff: a dónde avisar cuando el agente escala ────────────────────
#
# El destino se deduce de la URL. Elegí uno:
#
#   ntfy      https://ntfy.sh/un-topico-dificil-de-adivinar
#             Sin cuenta, sin API key. Instalás la app, te suscribís al tópico y
#             listo. Lo más rápido para tener el aviso en el teléfono.
#             Ojo: los tópicos son públicos, usá un nombre largo y random.
#
#   whatsapp  whatsapp:+5491112345678
#             Por el mismo Twilio que ya tenés. Cero servicios nuevos.
#             Ojo: al operador le aplica la ventana de 24 h, así que tiene que
#             haberle escrito al número del bot en el último día.
#
#   slack     https://hooks.slack.com/services/T00.../B00.../xxx
#             Incoming Webhook. Lo mejor si hay un equipo atrás.
#
#   discord   https://discord.com/api/webhooks/123.../xxx
#             Ajustes del canal -> Integraciones -> Webhooks.
#
#   telegram  https://api.telegram.org/bot<TOKEN>/sendMessage?chat_id=<ID>
#             Token de @BotFather. El chat_id va en la query, es obligatorio.
#
#   propio    https://tu-n8n/webhook/escalados
#             Cualquier otra URL recibe {"text": "..."}.
#
#   (vacío)   El escalado queda sólo en los logs y en la tabla escalations.
#
HANDOFF_NOTIFY_URL=

# ── Resiliencia ──────────────────────────────────────────────────────────────
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN_S=30

# ── Observabilidad ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# "demo" = el formato del video. "json" = líneas JSON para agregadores.
LOG_FORMAT=demo
