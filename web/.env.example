# Proyecto de Supabase: la key PUBLISHABLE (sb_publishable_...), nunca la
# secreta. El panel sólo lee, y RLS sólo deja leer a los usuarios cargados en la
# tabla operators.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# URL pública del agente (la misma base que PUBLIC_BASE_URL). Tomar, devolver y
# responder pasan por ahí.
VITE_AGENT_URL=http://localhost:8000
