# Proyecto de Supabase: la anon key, NUNCA la service_role. El panel sólo lee,
# y RLS sólo deja leer a los usuarios cargados en la tabla operators.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# URL pública del agente (la misma base que PUBLIC_BASE_URL). Tomar, devolver y
# responder pasan por ahí.
VITE_AGENT_URL=http://localhost:8000
